{
  "name": "fultimator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "dist-electron/main.js",
  "description": "Unofficial Fabula Ultima Tools",
  "author": "Fultimator <fultimator@gmail.com>",
  "scripts": {
    "start": "npm run dev:web",
    "build": "npm run build:web",
    "android:sync": "npm run build:web && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:run": "npm run android:build && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "dev:web": "vite",
    "dev:electron": "vite --config vite.electron.config.ts",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:web": "node DownloadTranslations.js && npm run build:vite",
    "build:electron": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc && npm run build:vite -- --config vite.electron.config.ts && electron-builder",
    "build:electron:nopublish": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc && npm run build:vite -- --config vite.electron.config.ts && electron-builder --publish never",
    "build:electron:local": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc && npm run build:vite -- --config vite.electron.config.ts && electron-builder --linux AppImage --publish never",
    "translate:build": "node DownloadTranslations.js && npm run build:vite",
    "build-size": "du -sh dist/",
    "serve": "npx serve dist",
    "local-deploy": "node DownloadTranslations.js && npm run build:vite && npx serve dist",
    "deploy": "node DownloadTranslations.js && npm run build:vite && firebase deploy",
    "translate": "node DownloadTranslations.js",
    "lint": "eslint . --report-unused-disable-directives-severity warn",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:parity": "vitest run src/forms/tests/parity",
    "test:roundtrip": "vitest run src/forms/tests/roundtrip",
    "test:forms": "vitest run src/forms/tests",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@libpdf/core": "^0.5.3",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.18.0",
    "@supabase/supabase-js": "^2.119.2",
    "axios": "^1.21.1",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^4.4.0",
    "deep-equal": "^2.2.3",
    "electron-store": "^12.0.0",
    "firebase": "^13.4.0",
    "googleapis": "^190.0.0",
    "history": "^5.3.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lodash.debounce": "^4.0.8",
    "papaparse": "^5.7.1",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-confetti": "^6.4.0",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^19.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "semver": "^7.8.6",
    "stream-browserify": "^3.0.0",
    "use-react-screenshot": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "buildcounter": {
    "version": "2.0.0",
    "count": 82
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  }
}
